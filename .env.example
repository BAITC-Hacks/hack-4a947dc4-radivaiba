# Local demonstration. Provisioning creates individual account passwords.
HOST=127.0.0.1
PORT=8080
# Local PostgreSQL. setup generates a password and fills DATABASE_URL.
POSTGRES_DB=careerquest
POSTGRES_USER=careerquest
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DATABASE_URL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=8000
# Evidence and generated account credentials remain private and outside Git.
EVIDENCE_DIR=data/evidence
ORG_TIMEZONE=Asia/Qyzylorda
APP_MODE=demo
# Empty uses the dataset snapshot date; set YYYY-MM-DD only for a planned demo.
DEMO_DATE=
BUILD_VERSION=local
